{
  "schema_version": 1,
  "updated": "2026-07-18",
  "default_profile": "coding-balanced",
  "profiles": {
    "chat-fast": {
      "label": "Chat / Web research (fast)",
      "preset": "WebUIChat",
      "client": "WebUI",
      "context_tokens": 16384,
      "kv": { "k": "q8_0", "v": "q8_0" },
      "gpu_offload": "auto",
      "flash_attention": "On",
      "mcp": "Light",
      "notes": "Fast first response; use for browsing and short chats."
    },
    "coding-balanced": {
      "label": "OpenCode coding (balanced)",
      "preset": "OpenCodeCoding",
      "client": "OpenCode",
      "context_tokens": 32768,
      "kv": { "k": "q8_0", "v": "q8_0" },
      "gpu_offload": "auto",
      "flash_attention": "On",
      "mcp": "None",
      "notes": "Default coding profile; AutoFit is allowed to reduce GPU layers."
    },
    "research-standard": {
      "label": "Deep research (standard)",
      "preset": "DeepResearchStandard",
      "client": "DeepResearch",
      "context_tokens": 32768,
      "kv": { "k": "q8_0", "v": "q8_0" },
      "gpu_offload": "auto",
      "flash_attention": "On",
      "mcp": "Light",
      "notes": "Evidence collection with bounded concurrency."
    },
    "heavy-model": {
      "label": "Heavy model / low memory",
      "preset": "OpenCodeCoding",
      "client": "OpenCode",
      "context_tokens": 16384,
      "kv": { "k": "q8_0", "v": "q4_0" },
      "gpu_offload": "auto",
      "flash_attention": "On",
      "mcp": "None",
      "notes": "Challenging profile: shorter context and asymmetric KV to fit larger GGUFs."
    }
  },
  "policy": {
    "docker": false,
    "wsl": false,
    "bind_address": "127.0.0.1",
    "default_cache_ram_mib": 8192,
    "long_context_cache_ram_mib": 4096,
    "heavy_model_cache_ram_mib": 2048,
    "auto_offload": true,
    "no_warmup": false,
    "context_ladder": [16384, 32768, 49152, 65536, 98304, 131072]
  }
}
