# --- Dependencies & runtimes ---
node_modules/
package-lock.json
.venv/
venv/
__pycache__/

# --- Local machine artifacts (never share) ---
*.exe
*.dll
*.lnk
*.log
*.db
*.sqlite
*.sqlite3

# --- Secrets ---
.env
.env.*
*.pem
*.key

# --- Personal / runtime data (sessions, results, browser output, caches) ---
mcp-data/
mcp-share/
mcp-browser-output/
sessions/
logs/
.freebuff/
local-deep-research-test/

# --- Character library (local creative assets, edited via the Web GUI) ---
# index.json (schema template) stays tracked; per-character cards are local.
config/characters/*.json
!config/characters/index.json
config/characters/ref/

# --- NSFW phrase knowledge base (local only, explicit content) ---
# Untracked + renamed 2026-10-04: cloud AI reviews of the repo kept tripping
# over it. The DO-NOT-READ filename tells AI reviewers to skip the file.
# h3-chat.py still loads it from this local path.
config/DO-NOT-READ-local-style-notes.json

# --- Downloaded model binaries (sd.cpp runtime downloads, multi-GB) ---
tools/sd.cpp/models/
tools/sd.cpp/old/

# --- Test output ---
test-*.log
test-*.out.log
test-*.err.log
tools/test-output*.json
tools/test-output*.log
tools/plan-quality-results.json

# --- Local generated artifacts (Web GUI) ---
config/models-config.json
config/run-results.json

# --- Scratch / residue files ---
tools/tmp-*
tools/*-results.json
tools/explicit-e2e-*.json
tools/comfyui-restart.log.err
