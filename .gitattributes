# Normalize line endings; Windows launcher scripts must stay CRLF to run safely.
* text=auto
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.png   binary
*.jpg   binary
*.gif   binary
*.mp4   binary
*.dll   binary
*.exe   binary
*.gguf  binary
*.safetensors binary
*.zip   binary
*.7z    binary
