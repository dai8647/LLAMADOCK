{
  "prompt": {
    "1": {
      "class_type": "LoadVideo",
      "inputs": { "file": "" },
      "_meta": { "title": "Load Video (server sets file)" }
    },
    "2": {
      "class_type": "GetVideoComponents",
      "inputs": { "video": ["1", 0] },
      "_meta": { "title": "Split frames / audio / fps" }
    },
    "3": {
      "class_type": "UpscaleModelLoader",
      "inputs": { "model_name": "RealESRGAN_x4plus.pth" },
      "_meta": { "title": "Load Upscale Model (RealESRGAN x4)" }
    },
    "4": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": { "upscale_model": ["3", 0], "image": ["2", 0] },
      "_meta": { "title": "Upscale x4 (tiled)" }
    },
    "5": {
      "class_type": "ImageScale",
      "inputs": {
        "image": ["4", 0],
        "upscale_method": "lanczos",
        "width": 2688,
        "height": 1536,
        "crop": "disabled"
      },
      "_meta": { "title": "Target size (server sets 2x/4x)" }
    },
    "6": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": ["5", 0],
        "fps": ["2", 2],
        "audio": ["2", 1]
      },
      "_meta": { "title": "Re-mux with original audio" }
    },
    "7": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["6", 0],
        "filename_prefix": "h3_upscaled",
        "format": "mp4",
        "codec": { "codec": "h264", "encoding": { "encoding": "re-encode", "crf": 18 } }
      },
      "_meta": { "title": "Save upscaled video" }
    }
  }
}
